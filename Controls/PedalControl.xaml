<UserControl x:Class="Jrig.Controls.PedalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Jrig.Controls">

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="240" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Expanded}" Value="True">
                    <Setter Property="Width" Value="340" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8A8A94" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="26" Height="26" CornerRadius="13" Background="Transparent">
                            <TextBlock Text="✕" FontSize="12" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Expanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="ChevronButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8A8A94" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="26" Height="26" CornerRadius="13" Background="Transparent">
                            <TextBlock x:Name="T" Text="▸" FontSize="14" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Expanded}" Value="True">
                                <Setter TargetName="T" Property="Text" Value="▾" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9A9AA6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Blue bar that lights up while a dragged pedal would be dropped just before this one -->
        <Rectangle Grid.Column="0" Width="4" Margin="0,16" RadiusX="2" RadiusY="2" HorizontalAlignment="Center">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Fill" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InsertBefore}" Value="True">
                            <Setter Property="Fill" Value="#4FC3F7" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- The pedal itself -->
        <Border Grid.Column="1" CornerRadius="12" BorderThickness="2" Padding="14,10,14,14"
                BorderBrush="{Binding AccentBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#34343C" Offset="0" />
                    <GradientStop Color="#1F1F25" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: grab it to drag the pedal -->
                <Border x:Name="Header" Grid.Row="0" Background="Transparent" Cursor="SizeAll" Padding="0,0,0,6"
                        ToolTip="Drag to reorder. Double-click to minimize / maximize. Drop on the library to remove."
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseLeftButtonUp="Header_MouseLeftButtonUp"
                        MouseMove="Header_MouseMove">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ChevronButton}"
                                ToolTip="Minimize / maximize this pedal" Click="Toggle_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}"
                                ToolTip="Remove pedal" Click="Remove_Click" />
                        <TextBlock DockPanel.Dock="Left" Text="≡" FontSize="20" Foreground="#6A6A75"
                                   Margin="0,-3,10,0" />
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Everything below the header is only shown when the pedal is maximized -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Expanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Knobs -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Parameters}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5" HorizontalAlignment="Center">
                                    <c:KnobControl Width="58" Height="58"
                                                   Value="{Binding Normalized, Mode=TwoWay}"
                                                   DefaultValue="{Binding DefaultNormalized}"
                                                   Accent="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type c:PedalControl}}}"
                                                   ToolTip="Drag up/down to turn. Shift = fine. Double-click = reset." />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SmallLabel}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource SmallLabel}" Foreground="White" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Live readout: tuner note + needle, looper state + position, optional buttons -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,0"
                                Visibility="{Binding HasReadout, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ReadoutHeadline}" FontSize="30" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ReadoutDetail}" Style="{StaticResource SmallLabel}" />
                        <Slider Minimum="-1" Maximum="1" Value="{Binding ReadoutNeedle, Mode=OneWay}"
                                IsHitTestVisible="False" Focusable="False" Margin="0,8,0,0"
                                TickPlacement="BottomRight" TickFrequency="0.5"
                                Visibility="{Binding HasNeedle, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar Height="8" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                     Value="{Binding ReadoutProgress, Mode=OneWay}"
                                     Foreground="{Binding AccentBrush}" Background="#101014" BorderThickness="0"
                                     Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0"
                                      Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Margin="3,0" Padding="4,6" FontSize="11"
                                            FontWeight="SemiBold" Click="Action_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Gain reduction meter (only for pedals that provide one) -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0"
                                Visibility="{Binding HasMeter, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GainReductionText}"
                                       FontSize="11" Foreground="White" />
                            <TextBlock Text="GAIN REDUCTION" FontSize="10" Foreground="#9A9AA6" />
                        </DockPanel>
                        <ProgressBar Height="8" Margin="0,4,0,0" Minimum="0" Maximum="24"
                                     Value="{Binding GainReduction, Mode=OneWay}"
                                     Foreground="{Binding AccentBrush}" Background="#101014" BorderThickness="0" />
                    </StackPanel>

                    <!-- LED + footswitch -->
                    <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center" Margin="0,0,0,8" Stroke="#111" StrokeThickness="1">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#3A1414" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                            <Setter Property="Fill" Value="#FF3B30" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <ToggleButton Width="54" Height="54" Cursor="Hand" IsChecked="{Binding Active, Mode=TwoWay}"
                                      ToolTip="Click to switch the pedal on / off">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Ellipse Fill="#4A4A54" Stroke="#8A8A94" StrokeThickness="2" />
                                        <Ellipse x:Name="Cap" Margin="9" Fill="#C4C4CC" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Cap" Property="Fill" Value="#9A9AA3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- Minimized: just an on/off button -->
                <ToggleButton Grid.Row="2" Height="30" Margin="0,2,0,0" Cursor="Hand"
                              IsChecked="{Binding Active, Mode=TwoWay}" ToolTip="Click to switch the pedal on / off">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="15" Background="#3A3A42" BorderBrush="#8A8A94" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse x:Name="Led" Width="10" Height="10" Fill="#3A1414" Stroke="#111" Margin="0,0,8,0" />
                                                <TextBlock x:Name="Txt" Text="OFF" FontSize="12" FontWeight="Bold" Foreground="#C4C4CC" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Led" Property="Fill" Value="#FF3B30" />
                                                <Setter TargetName="Txt" Property="Text" Value="ON" />
                                                <Setter TargetName="Txt" Property="Foreground" Value="White" />
                                                <Setter TargetName="Bd" Property="Background" Value="#4A3030" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Expanded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
