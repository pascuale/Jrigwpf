<Window x:Class="Jrig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Jrig.Controls"
        Title="jrig" Width="1260" Height="640" MinWidth="900" MinHeight="560"
        Background="#16161A" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EEEEF2" />
            <Setter Property="Background" Value="#3A3A42" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4C4C58" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9A9AA6" />
        </Style>

        <Style x:Key="ToolbarCombo" TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ============================== toolbar ============================== -->
        <Border DockPanel.Dock="Top" Background="#222228" Padding="14,10,14,12">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="jrig" FontSize="24" FontWeight="Bold" Foreground="#F2B134"
                               VerticalAlignment="Center" Margin="0,0,18,0" />

                    <TextBlock Text="SOURCE" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="SourceCombo" Width="250" Style="{StaticResource ToolbarCombo}"
                              ToolTip="Guitar = your Guitar Link through ASIO. Simulated = a built-in virtual guitar, no hardware needed."
                              SelectionChanged="Source_Changed" />
                    <Button x:Name="LoadFileButton" Content="Audio file..." Style="{StaticResource DarkButton}"
                            Visibility="Collapsed" Click="LoadFile_Click"
                            ToolTip="Choose a recording to loop through the pedals" />
                    <Button x:Name="PickButton" Content="Pick" Style="{StaticResource DarkButton}"
                            Visibility="Collapsed" IsEnabled="False" Click="Pick_Click"
                            ToolTip="Hit the string again" />

                    <TextBlock Text="AUDIO" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,4,0" />
                    <ComboBox x:Name="ApiCombo" Width="140" Style="{StaticResource ToolbarCombo}"
                              ToolTip="Windows audio = the same kind Deplike and AmpliTube use (recommended for the Guitar Link). ASIO needs ASIO4ALL / FlexASIO."
                              SelectionChanged="Api_Changed" />

                    <StackPanel x:Name="WasapiPanel" Orientation="Horizontal">
                        <TextBlock Text="IN" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        <ComboBox x:Name="CaptureCombo" Width="210" Style="{StaticResource ToolbarCombo}"
                                  ToolTip="Where the guitar comes in. Pick 'Microphone (USB Audio CODEC)', the one AmpliTube uses." />
                        <TextBlock Text="OUT" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        <ComboBox x:Name="RenderCombo" Width="210" Style="{StaticResource ToolbarCombo}"
                                  ToolTip="Where you listen. Pick 'Speakers (USB Audio CODEC)' to hear it from the Guitar Link's headphone jack." />
                        <CheckBox x:Name="ExclusiveCheck" Content="Exclusive" Foreground="#EEEEF2" VerticalAlignment="Center"
                                  Margin="6,0,2,0" IsChecked="True"
                                  ToolTip="Lowest delay (what Deplike's 'Windows audio exclusive mode' does). Untick if another program needs the device or it will not start." />
                        <Button x:Name="RescanButton" Content="Rescan" Style="{StaticResource DarkButton}" Click="RescanDevices_Click"
                                ToolTip="Look for audio devices again" />
                    </StackPanel>

                    <StackPanel x:Name="AsioPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="DRIVER" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        <ComboBox x:Name="DriverCombo" Width="200" Style="{StaticResource ToolbarCombo}" />
                        <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource DarkButton}" Click="RefreshDrivers_Click"
                                ToolTip="Look for ASIO drivers again" />
                    </StackPanel>

                    <TextBlock Text="INPUT" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <ComboBox x:Name="InputCombo" Width="90" Style="{StaticResource ToolbarCombo}" />

                    <TextBlock Text="RATE" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <ComboBox x:Name="RateCombo" Width="80" Style="{StaticResource ToolbarCombo}" />

                    <Button x:Name="StartButton" Content="Start" Style="{StaticResource DarkButton}"
                            Background="#2E7D32" Width="84" Margin="14,2,4,2" Click="StartStop_Click" />
                    <Button x:Name="DriverSettingsButton" Content="Driver settings" Style="{StaticResource DarkButton}" Click="DriverSettings_Click"
                            Visibility="Collapsed"
                            ToolTip="Opens the ASIO driver's own window. Set the buffer size there (64 to 128 samples is ideal)." />

                    <Button x:Name="DiagButton" Content="Diagnostics" Style="{StaticResource DarkButton}" Click="Diagnostics_Click"
                            Background="#6A4C93"
                            ToolTip="Live 'where does the signal die' check, device report and log" />

                    <Button Content="Save preset" Style="{StaticResource DarkButton}" Margin="22,2,4,2" Click="SavePreset_Click" />
                    <Button Content="Load preset" Style="{StaticResource DarkButton}" Click="LoadPreset_Click" />
                </WrapPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <!-- Input gain + meter -->
                    <StackPanel Grid.Column="0" Margin="4,0,18,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="White"
                                       Text="{Binding Value, ElementName=InputGainSlider, StringFormat='{}{0:F1} dB'}" />
                            <TextBlock Text="INPUT GAIN" Style="{StaticResource Label}" />
                        </DockPanel>
                        <Slider x:Name="InputGainSlider" Minimum="-12" Maximum="24" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="False" Margin="0,4,0,4"
                                ValueChanged="InputGain_Changed" />
                        <ProgressBar x:Name="InputMeter" Height="8" Minimum="0" Maximum="1"
                                     Foreground="#4CD964" Background="#101014" BorderThickness="0" />
                    </StackPanel>

                    <!-- Output volume + meter -->
                    <StackPanel Grid.Column="1" Margin="4,0,18,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="White"
                                       Text="{Binding Value, ElementName=OutputGainSlider, StringFormat='{}{0:F1} dB'}" />
                            <TextBlock Text="OUTPUT VOLUME" Style="{StaticResource Label}" />
                        </DockPanel>
                        <Slider x:Name="OutputGainSlider" Minimum="-40" Maximum="6" Value="0"
                                Margin="0,4,0,4" ValueChanged="OutputGain_Changed" />
                        <ProgressBar x:Name="OutputMeter" Height="8" Minimum="0" Maximum="1"
                                     Foreground="#4CD964" Background="#101014" BorderThickness="0" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Column="2" Foreground="#CFCFD6" FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================== body ============================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pedal library -->
            <Border Grid.Column="0" Background="#1C1C21" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PEDAL LIBRARY" Style="{StaticResource Label}" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="11" Foreground="#777782" Margin="0,10,0,0"
                               Text="Drag a pedal onto the board (or double-click it). Drag a pedal from the board back here to remove it." />

                    <ListBox x:Name="LibraryList" ItemsSource="{Binding Catalog}" Background="Transparent"
                             BorderThickness="0" AllowDrop="True" HorizontalContentAlignment="Stretch"
                             PreviewMouseLeftButtonDown="Library_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="Library_PreviewMouseMove"
                             MouseDoubleClick="Library_MouseDoubleClick"
                             DragOver="Library_DragOver" Drop="Library_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2A31" CornerRadius="8" Padding="10,9">
                                    <DockPanel>
                                        <Rectangle DockPanel.Dock="Left" Width="4" RadiusX="2" RadiusY="2"
                                                   Margin="0,0,10,0" Fill="{Binding AccentHex}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Description}" Foreground="#9A9AA6" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Pedalboard: signal flows left to right, IN -> pedals -> OUT -->
            <ScrollViewer x:Name="BoardScroll" Grid.Column="1" Background="#101014"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          AllowDrop="True" DragOver="Board_DragOver" DragLeave="Board_DragLeave" Drop="Board_Drop">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="18">

                    <StackPanel VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#44444E" Stroke="#8A8A94" StrokeThickness="3" />
                        <TextBlock Text="IN" Foreground="#8A8A94" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <Rectangle Width="10" Height="3" Fill="#55555F" VerticalAlignment="Center" Margin="2,0,0,14" />

                    <ItemsControl x:Name="PedalItems" ItemsSource="{Binding Pedals}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <c:PedalControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty-board hint (hidden as soon as there is a pedal) -->
                    <Border Width="240" Height="140" CornerRadius="12" BorderThickness="2" BorderBrush="#33333C"
                            VerticalAlignment="Center" Margin="12,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pedals.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Drag a pedal here" Foreground="#6A6A75" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Rectangle x:Name="EndMarker" Width="4" Height="120" Margin="2,0,8,0" RadiusX="2" RadiusY="2"
                               Fill="Transparent" VerticalAlignment="Center" />

                    <Rectangle Width="10" Height="3" Fill="#55555F" VerticalAlignment="Center" Margin="0,0,2,14" />
                    <StackPanel VerticalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#44444E" Stroke="#8A8A94" StrokeThickness="3" />
                        <TextBlock Text="OUT" Foreground="#8A8A94" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
